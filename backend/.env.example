# Salin file ini ke `.env` lalu sesuaikan nilainya.

# Server
APP_PORT=8080
APP_ENV=development

# CORS - origin front-end. SvelteKit dev server default = 5173.
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Database PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=elearning_unipi
DB_SSLMODE=disable

# JWT - GANTI di production. Generate via: openssl rand -base64 48
JWT_SECRET=ubah-secret-ini-jadi-string-panjang-acak-min-32-karakter
JWT_EXPIRE_HOURS=24

# Unggahan berkas
UPLOAD_DIR=./uploads
MAKS_MATERI_MB=25
MAKS_PENGUMPULAN_MB=10
EKSTENSI_MATERI=.pdf,.ppt,.pptx,.doc,.docx
EKSTENSI_PENGUMPULAN=.pdf,.doc,.docx,.zip,.rar

# Akun administrator awal (dibuat otomatis saat basis data masih kosong).
# GANTI kata sandi ini sebelum sistem dipakai.
ADMIN_NAMA=Administrator
ADMIN_EMAIL=admin@unipem.ac.id
ADMIN_PASSWORD=admin12345
